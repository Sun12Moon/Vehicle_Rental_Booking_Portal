Project VehicleRentalPortal {
  database_type: "PostgreSQL"

  Note: '''
  Vehicle Rental Booking Portal
  Version 1.0
  Database: PostgreSQL
  '''
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

Enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

Enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
}

Enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
}

Enum TransmissionType {
  MANUAL
  AUTOMATIC
}

Enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

Enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  CASH
}

Enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

Enum AgreementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

Enum ConditionStage {
  BEFORE_RENTAL
  AFTER_RENTAL
}

Enum MediaType {
  PHOTO
  VIDEO
}

Enum MediaSource {
  ADMIN
  CUSTOMER
}

//////////////////////////////////////////////////////
// ROLES
//////////////////////////////////////////////////////

Table roles {
  role_id int [pk, increment]
  role_name varchar(50) [not null, unique]
  description text
  created_at datetime
  updated_at datetime
  Note: 'System roles'
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

Table users {
  user_id int [pk, increment]
  role_id int [not null, ref: > roles.role_id]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  is_active boolean [default: true]
  status UserStatus [default: `ACTIVE`]
  email_verified boolean [default: false]
  last_login datetime
  created_at datetime
  updated_at datetime
  deleted_at datetime
  Note: 'Stores authentication information'
  indexes {
    role_id
  }
}

//////////////////////////////////////////////////////
// CUSTOMER PROFILES
//////////////////////////////////////////////////////

Table customer_profiles {
  customer_id int [pk, increment]
  user_id int [not null, unique, ref: > users.user_id]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  gender varchar(20)
  date_of_birth date
  phone varchar(20) [not null, unique]
  alternate_phone varchar(20)
  driving_license_no varchar(100) [not null, unique]
  license_expiry date
  aadhaar_number varchar(20)
  address text
  city varchar(100)
  state varchar(100)
  country varchar(100)
  postal_code varchar(15)
  emergency_contact_name varchar(100)
  emergency_contact_phone varchar(20)
  profile_image varchar(255)
  created_at datetime
  updated_at datetime
  deleted_at datetime
  Note: 'One customer profile per user'
  indexes {
    city
  }
}

//////////////////////////////////////////////////////
// VEHICLE CATEGORIES
//////////////////////////////////////////////////////

Table vehicle_categories {
  category_id int [pk, increment]
  category_name varchar(100) [not null, unique]
  description text
  seating_capacity int
  created_at datetime
  updated_at datetime
  Note: 'Vehicle classifications'
}

//////////////////////////////////////////////////////
// BRANCHES
//////////////////////////////////////////////////////

Table branches {
  branch_id int [pk, increment]
  branch_name varchar(100) [not null, unique]
  address text
  city varchar(100)
  state varchar(100)
  postal_code varchar(15)
  phone varchar(20)
  created_at datetime
  updated_at datetime
  Note: 'Stores vehicle rental branch locations'
}

//////////////////////////////////////////////////////
// VEHICLES
//////////////////////////////////////////////////////

Table vehicles {
  vehicle_id int [pk, increment]
  category_id int [not null, ref: > vehicle_categories.category_id]
  branch_id int [not null, ref: > branches.branch_id]
  registration_number varchar(50) [not null, unique]
  brand varchar(100) [not null]
  model varchar(100) [not null]
  variant varchar(100)
  manufacture_year int
  color varchar(50)
  fuel_type FuelType
  transmission TransmissionType
  engine_capacity varchar(50)
  seating_capacity int
  mileage decimal(10,2)
  daily_rent decimal(10,2) [not null]
  security_deposit decimal(10,2)
  status VehicleStatus [default: `AVAILABLE`]
  image_url varchar(255)
  chassis_number varchar(100) [unique]
  insurance_number varchar(100)
  insurance_expiry date
  pollution_expiry date
  last_service_date date
  next_service_date date
  current_odometer int
  description text
  created_at datetime
  updated_at datetime
  deleted_at datetime
  Note: 'Vehicle inventory'
  indexes {
    category_id
    branch_id
    brand
    model
    status
    daily_rent
  }
}

//////////////////////////////////////////////////////
// BOOKINGS
//////////////////////////////////////////////////////

Table bookings {
  booking_id int [pk, increment]
  customer_id int [not null, ref: > customer_profiles.customer_id]
  vehicle_id int [not null, ref: > vehicles.vehicle_id]
  booking_reference varchar(30) [not null, unique]
  booking_date datetime
  pickup_date date [not null]
  return_date date [not null]
  actual_pickup datetime
  actual_return datetime
  pickup_location varchar(150) [not null]
  return_location varchar(150) [not null]
  booking_status BookingStatus [default: `PENDING`]
  total_days int
  daily_rent decimal(10,2)
  security_deposit decimal(10,2)
  discount decimal(10,2)
  tax decimal(10,2)
  total_amount decimal(10,2)
  cancellation_reason text
  cancelled_at datetime
  remarks text
  created_at datetime
  updated_at datetime
  indexes {
    customer_id
    vehicle_id
    booking_status
    pickup_date
    return_date
    booking_date
  }
  Note: '''
  Central reservation table.
  One Customer can create many bookings.
  One Vehicle can have many bookings.
  Concurrent booking validation should prevent overlapping confirmed bookings.
  '''
}

//////////////////////////////////////////////////////
// PAYMENTS
//////////////////////////////////////////////////////

Table payments {
  payment_id int [pk, increment]
  booking_id int [not null, unique, ref: > bookings.booking_id]
  transaction_reference varchar(100) [unique, not null]
  payment_method PaymentMethod [not null]
  amount decimal(10,2) [not null]
  payment_status PaymentStatus [default: `PENDING`]
  payment_gateway varchar(100)
  gateway_response text
  payment_date datetime
  created_at datetime
  updated_at datetime
  indexes {
    payment_status
  }
  Note: 'One payment belongs to one booking.'
}

//////////////////////////////////////////////////////
// INVOICES
//////////////////////////////////////////////////////

Table invoices {
  invoice_id int [pk, increment]
  payment_id int [not null, unique, ref: > payments.payment_id]
  invoice_number varchar(50) [unique, not null]
  invoice_date datetime
  subtotal decimal(10,2)
  tax_amount decimal(10,2)
  total_amount decimal(10,2)
  pdf_path varchar(255)
  created_at datetime
  updated_at datetime
  Note: 'Generated after successful payment.'
}

//////////////////////////////////////////////////////
// RENTAL AGREEMENTS
//////////////////////////////////////////////////////

Table rental_agreements {
  agreement_id int [pk, increment]
  booking_id int [not null, unique, ref: > bookings.booking_id]
  agreement_number varchar(50) [unique, not null]
  agreement_date datetime
  agreement_status AgreementStatus [default: `ACTIVE`]
  document_path varchar(255)
  signed_at datetime
  created_at datetime
  updated_at datetime
  Note: 'One rental agreement per booking.'
}

//////////////////////////////////////////////////////
// REPORTS
//////////////////////////////////////////////////////

Table reports {
  report_id int [pk, increment]
  report_type varchar(100)
  generated_by int [ref: > users.user_id]
  generated_at datetime
  file_path varchar(255)
  created_at datetime
  indexes {
    report_type
    generated_by
  }
  Note: 'Stores metadata for generated reports.'
}

//////////////////////////////////////////////////////
// VEHICLE IMAGES
//////////////////////////////////////////////////////

Table vehicle_images {
  image_id int [pk, increment]
  vehicle_id int [not null, ref: > vehicles.vehicle_id]
  image_url varchar(255) [not null]
  is_primary boolean [default: false]
  uploaded_at datetime
  indexes {
    vehicle_id
  }
  Note: 'Stores multiple images for a vehicle.'
}

//////////////////////////////////////////////////////
// BOOKING STATUS HISTORY
//////////////////////////////////////////////////////

Table booking_status_history {
  history_id int [pk, increment]
  booking_id int [not null, ref: > bookings.booking_id]
  status BookingStatus [not null]
  changed_by int [ref: > users.user_id]
  changed_at datetime
  remarks text
  indexes {
    booking_id
    status
    changed_at
  }
  Note: 'Stores the status of a booking at different points in its lifecycle.'
}

//////////////////////////////////////////////////////
// VEHICLE CONDITION MEDIA
//////////////////////////////////////////////////////

Table vehicle_condition_media {
  media_id int [pk, increment]
  booking_id int [not null, ref: > bookings.booking_id]
  uploaded_by int [not null, ref: > users.user_id]
  condition_stage ConditionStage [not null]
  media_type MediaType [not null]
  media_source MediaSource [not null]
  file_path varchar(500) [not null]
  storage_provider varchar(50) [not null]
  customer_visible boolean [default: false]
  uploaded_at datetime
  description text
  indexes {
    booking_id
    uploaded_by
    condition_stage
    media_type
    media_source
    customer_visible
  }
  Note: '''
  Stores photos and videos documenting vehicle condition before and after a rental.
  Media can be uploaded by authorized users and selectively displayed in the customer portal.
  '''
}

//////////////////////////////////////////////////////
// MAINTENANCE RECORDS
//////////////////////////////////////////////////////

Table maintenance_records {
  maintenance_id int [pk, increment]
  vehicle_id int [not null, ref: > vehicles.vehicle_id]
  service_date date
  service_type varchar(100)
  service_center varchar(150)
  odometer_reading int
  service_cost decimal(10,2)
  next_service_due date
  remarks text
  created_at datetime
  indexes {
    vehicle_id
    service_date
  }
  Note: 'Vehicle maintenance history'
}

//////////////////////////////////////////////////////
// AUDIT LOGS
//////////////////////////////////////////////////////

Table audit_logs {
  log_id int [pk, increment]
  user_id int [ref: > users.user_id]
  action varchar(100)
  module varchar(100)
  entity_id int
  ip_address varchar(50)
  created_at datetime
  indexes {
    user_id
    module
  }
  Note: 'Tracks important administrative and system actions'
}
