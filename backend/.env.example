# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vehicle_rental_db
DB_USER=root
DB_PASSWORD=

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Demo credentials for local testing (Backend)
DEMO_ADMIN_EMAIL=admin@rentivo.in
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_USER_EMAIL=user@rentivo.in
DEMO_USER_PASSWORD=User@123

# Didit KYC Configuration (Server-Side Only - Only two secrets needed)
DIDIT_API_KEY=your_didit_api_key_here
DIDIT_WEBHOOK_SECRET=your_didit_webhook_signing_secret_here
